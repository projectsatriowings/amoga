{
  "name": "amoga",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n \"SERVER,CLIENT\" -c \"magenta,cyan\" \"npm run server\" \"vite\"",
    "dev:client": "vite",
    "dev:server": "npm run server:dev",
    "build": "npm --prefix server install && npm --prefix server run prisma:generate && vite build",
    "start": "node server/src/server.js",
    "postinstall": "npm --prefix server install && npm --prefix server run prisma:generate",
    "lint": "oxlint",
    "preview": "vite preview",
    "server": "node --watch-path=server/src server/src/server.js",
    "server:dev": "node --watch-path=server/src server/src/server.js",
    "db:migrate": "npm --prefix server run prisma:migrate",
    "db:deploy": "npm --prefix server run prisma:deploy",
    "db:seed": "npm --prefix server run prisma:seed",
    "db:seed:admin": "node server/prisma/seedAdmin.js",
    "test:server": "npm --prefix server test",
    "test:contrast": "node --loader ./image-loader.js test-checkout-contrast.js",
    "test:all": "node --loader ./image-loader.js test-checkout-contrast.js && node test-phase6.js && npm --prefix server test && node test-routes.js"
  },
  "dependencies": {
    "framer-motion": "^14.0.0",
    "lucide-react": "^1.53.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.29",
    "puppeteer-core": "^25.14.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.0"
  }
}
