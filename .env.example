# AMOGA E-COMMERCE ENVIRONMENT CONFIGURATION
# Backend Server & PostgreSQL Database

# PostgreSQL Connection String (Pooler or direct URL)
DATABASE_URL="postgresql://username:password@ep-host.aws.neon.tech/neondb?sslmode=require"

# Express Server Port
PORT=4000

# Node Environment (development | production | test)
NODE_ENV=development

# Allowed CORS Frontend Origin
FRONTEND_ORIGIN="http://localhost:5173"

# Secret salt for generating unguessable guest order access tokens
GUEST_ORDER_TOKEN_SECRET="amoga-guest-secret-token-change-in-production"

# Payment Architecture Configuration (Supported: test | razorpay | cashfree | stripe)
PAYMENT_PROVIDER="test"
PAYMENT_MODE="test"
PAYMENT_CURRENCY="INR"
TEST_PAYMENT_SECRET="test-hmac-secret-change-in-development"

# Razorpay Sandbox & Production Configuration
# In Sandbox mode, obtain test Key ID (starts with rzp_test_) and Key Secret from Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID="rzp_test_your_sandbox_key_id"
RAZORPAY_KEY_SECRET="your_sandbox_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_webhook_signing_secret"

# Alternative Gateway Placeholders
# CASHFREE_APP_ID="placeholder_app_id"
# CASHFREE_SECRET_KEY="placeholder_secret_key"
# STRIPE_SECRET_KEY="sk_test_placeholder"
# STRIPE_WEBHOOK_SECRET="whsec_placeholder"
