# AMOGA E-COMMERCE SERVER ENVIRONMENT
DATABASE_URL="postgresql://username:password@ep-host.aws.neon.tech/neondb?sslmode=require"
PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN="http://localhost:5173"
GUEST_ORDER_TOKEN_SECRET="amoga-guest-secret-token-change-in-production"

# Payment Architecture Configuration (Supported: test | razorpay | cashfree | stripe)
PAYMENT_PROVIDER="test"
PAYMENT_MODE="test"
PAYMENT_CURRENCY="INR"
TEST_PAYMENT_SECRET="test-hmac-secret-change-in-development"

# Razorpay Sandbox & Production Configuration
# In Sandbox mode, obtain test Key ID (starts with rzp_test_) and Key Secret from Razorpay Dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID="rzp_test_your_sandbox_key_id"
RAZORPAY_KEY_SECRET="your_sandbox_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_webhook_signing_secret"

# Alternative Gateway Placeholders
# CASHFREE_APP_ID="placeholder_app_id"
# CASHFREE_SECRET_KEY="placeholder_secret_key"
# STRIPE_SECRET_KEY="sk_test_placeholder"
# STRIPE_WEBHOOK_SECRET="whsec_placeholder"

# ==============================================================================
# EMAIL SERVICE CONFIGURATION (Choose One Option Below)
# ==============================================================================
# Canonical frontend base URL for constructing secure password reset links
FRONTEND_URL="http://localhost:5173"

# OPTION 1: SMTP (Gmail, Zoho, Hostinger, Outlook, AWS SES SMTP)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_SECURE="false" # Set "true" for port 465, "false" for 587
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-specific-password" # For Gmail, use an 16-character App Password
# SMTP_FROM='"Amoga Atelier" <amogastores05@gmail.com>'

# OPTION 2: Resend API (Recommended for modern SaaS)
# RESEND_API_KEY="re_1234567890abcdef..."
# RESEND_FROM='"Amoga Atelier" <onboarding@resend.dev>' # Or verified domain e.g. amogastores05@gmail.com

# OPTION 3: SendGrid API
# SENDGRID_API_KEY="SG.1234567890abcdef..."
# SENDGRID_FROM="amogastores05@gmail.com"

# OPTION 4: Local Development / Testing Mode
# When set to true, outbound emails are simulated and reset links are logged to console
# MOCK_EMAIL_DELIVERY="true"
