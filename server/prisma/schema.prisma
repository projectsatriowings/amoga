// AMOGA E-COMMERCE — PRISMA SCHEMA
// Supports Multi-Collection Storefronts (Food, Sarees, Jewellery, Tea), Persistent Orders & Admin Panel

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Collection {
  id               String    @id // 'food' | 'sarees' | 'jewellery' | 'tea'
  name             String
  slug             String    @unique
  tagline          String?
  heroHeading      String?
  heroSubheading   String?
  description      String?
  shortDescription String?
  heroImage        String?   @db.Text
  cardImage        String?   @db.Text
  theme            String?
  accentColor      String?
  themeConfig      Json?     // Full palette customization (bg, surface, text, accent, buttonBg, border, etc.)
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  products         Product[]

  @@map("collections")
}

model Product {
  id               String           @id @default(uuid())
  sourceId         String           @unique // e.g. 'f-turmeric-01', 's-kanchipuram-01', 'j-aurora-01'
  collectionId     String
  slug             String
  name             String
  tagline          String?
  description      String           @db.Text
  category         String
  categoryName     String?
  price            Decimal?         @db.Decimal(10, 2) // Nullable for unconfirmed bespoke items
  originalPrice    Decimal?         @db.Decimal(10, 2)
  discount         String?
  currency         String           @default("INR")
  image            String           @db.Text
  gallery          Json?            // Array of image paths/URLs
  packSize         String?
  inStock          Boolean          @default(true)
  stockQuantity    Int              @default(50)
  reservedQuantity Int              @default(0)
  lowStockThreshold Int             @default(5)
  isFeatured       Boolean          @default(false)
  badge            String?
  rating           Float?
  reviewCount      Int?
  specs            Json?            // Product attributes / technical specifications
  sourceCatalogue  String?
  verified         Boolean          @default(false)
  isActive         Boolean          @default(true)
  sku              String?          @unique
  hsnCode          String?
  gstRate          Decimal?         @db.Decimal(5, 2)
  isTaxInclusive   Boolean          @default(true)
  cessRate         Decimal?         @default(0.00) @db.Decimal(5, 2)
  taxClassification String?         @default("GOODS")
  taxTreatment      String?         @default("TAXABLE")
  taxVerificationStatus String      @default("PENDING_VERIFICATION")
  taxConfirmedBy    String?
  taxConfirmedAt    DateTime?
  taxNotes          String?         @db.Text
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  collection            Collection             @relation(fields: [collectionId], references: [id], onDelete: Restrict)
  variants              ProductVariant[]
  orderItems            OrderItem[]
  inventoryLogs         InventoryLog[]
  inventoryReservations InventoryReservation[]
  restockSubscriptions  RestockSubscription[]
  inventoryAlerts       InventoryAlert[]
  notificationJobs      RestockNotificationJob[]
  reviews               Review[]
  posSaleItems          PosSaleItem[]
  locationInventories   LocationInventory[]
  transferItems         StockTransferItem[]
  locationMovementLogs  LocationMovementLog[]

  @@unique([collectionId, slug])
  @@index([collectionId])
  @@index([category])
  @@index([inStock])
  @@map("products")
}

model ProductVariant {
  id            String         @id @default(uuid())
  sourceId      String?        // e.g. 'v-wine', 'ring-16'
  productId     String
  name          String         // e.g. 'Royal Wine', 'US 7'
  sku           String?        @unique
  price         Decimal?       @db.Decimal(10, 2)
  hsnCode       String?
  gstRate       Decimal?       @db.Decimal(5, 2)
  isTaxInclusive Boolean?
  cessRate      Decimal?       @default(0.00) @db.Decimal(5, 2)
  taxTreatment  String?        @default("TAXABLE")
  taxVerificationStatus String? @default("PENDING_VERIFICATION")
  taxConfirmedBy String?
  taxConfirmedAt DateTime?
  taxNotes      String?        @db.Text
  inStock          Boolean          @default(true)
  stockQuantity    Int              @default(25)
  reservedQuantity Int              @default(0)
  lowStockThreshold Int             @default(5)
  attributes       Json?          // e.g. { hex: '#451523' } or { size: 'US 6' }
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  product               Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems            OrderItem[]
  inventoryLogs         InventoryLog[]
  inventoryReservations InventoryReservation[]
  restockSubscriptions  RestockSubscription[]
  inventoryAlerts       InventoryAlert[]
  notificationJobs      RestockNotificationJob[]
  posSaleItems          PosSaleItem[]
  locationInventories   LocationInventory[]
  transferItems         StockTransferItem[]
  locationMovementLogs  LocationMovementLog[]

  @@index([productId])
  @@map("product_variants")
}

enum OrderStatus {
  PENDING_PAYMENT
  PENDING_CONFIRMATION
  CONFIRMED
  PROCESSING
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  CREATED
  PENDING
  AUTHORIZED
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum AdminRole {
  SUPER_ADMIN
  CATALOGUE_MANAGER
  ORDER_MANAGER
  CONTENT_MANAGER
  STALL_MANAGER
  STALL_CASHIER
}

model Order {
  id                    String        @id @default(uuid())
  orderReference        String        @unique // Public non-guessable reference: e.g. 'AMOGA-ORD-2026-XXXXX'
  idempotencyKey        String?       @unique // Duplicate submission protection
  guestAccessTokenHash  String?       // Secure hash for guest retrieval
  status                OrderStatus   @default(PENDING_PAYMENT)
  paymentStatus         PaymentStatus @default(PENDING)
  currency              String        @default("INR")
  
  // Financial totals snapshot
  subtotal              Decimal       @db.Decimal(10, 2)
  shippingAmount        Decimal       @default(0.00) @db.Decimal(10, 2)
  taxAmount             Decimal       @default(0.00) @db.Decimal(10, 2)
  discountAmount        Decimal       @default(0.00) @db.Decimal(10, 2)
  totalAmount           Decimal       @db.Decimal(10, 2)

  // GST and Tax Compliance Snapshot
  invoiceNumber         String?       @unique
  invoiceDate           DateTime?
  sellerLegalName       String?
  sellerTradeName       String?
  sellerGstin           String?
  sellerAddress         String?
  sellerState           String?
  sellerStateCode       String?
  customerGstin         String?
  customerBusinessName  String?
  placeOfSupply         String?
  placeOfSupplyCode     String?
  isInterState          Boolean       @default(false)
  taxableAmount         Decimal       @default(0.00) @db.Decimal(10, 2)
  cgstAmount            Decimal       @default(0.00) @db.Decimal(10, 2)
  sgstAmount            Decimal       @default(0.00) @db.Decimal(10, 2)
  igstAmount            Decimal       @default(0.00) @db.Decimal(10, 2)
  cessAmount            Decimal       @default(0.00) @db.Decimal(10, 2)
  taxSnapshot           Json?

  // Customer Contact & Shipping Destination Snapshot
  customerName          String
  customerEmail         String
  customerPhone         String
  addressLine1          String
  addressLine2          String?
  city                  String
  state                 String
  pincode               String
  deliveryInstructions  String?       @db.Text

  // Carrier & Fulfilment tracking
  carrier               String?
  trackingNumber        String?
  trackingUrl           String?
  shippingSnapshot      Json?
  pricingSnapshot       Json?

  // Customer relation
  customerId            String?
  customer              Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // Mode and metadata
  isDemo                Boolean       @default(false)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  items                 OrderItem[]
  payments              Payment[]
  trackingEvents        OrderTrackingEvent[]

  @@index([orderReference])
  @@index([customerEmail])
  @@index([customerId])
  @@index([createdAt])
  @@map("orders")
}

model Customer {
  id                    String            @id @default(uuid())
  email                 String            @unique
  name                  String
  phone                 String?
  passwordHash          String
  isActive              Boolean           @default(true)
  lastLoginAt           DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  sessions              CustomerSession[]
  addresses             CustomerAddress[]
  orders                Order[]
  restockSubscriptions  RestockSubscription[]
  reviews               Review[]
  passwordResetTokens   PasswordResetToken[]

  @@map("customers")
}

model CustomerSession {
  id                    String        @id @default(uuid())
  customerId            String
  tokenHash             String        @unique
  expiresAt             DateTime
  createdAt             DateTime      @default(now())

  customer              Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([tokenHash])
  @@map("customer_sessions")
}

model CustomerAddress {
  id                    String        @id @default(uuid())
  customerId            String
  label                 String?       // e.g. 'Home', 'Work', 'Estate'
  fullName              String
  phone                 String
  addressLine1          String
  addressLine2          String?
  city                  String
  state                 String
  pincode               String
  isDefault             Boolean       @default(false)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  customer              Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_addresses")
}

model OrderTrackingEvent {
  id                    String        @id @default(uuid())
  orderId               String
  status                OrderStatus
  title                 String        // e.g. 'Order Confirmed', 'Processing at Atelier', 'Shipped', 'Out for Delivery', 'Delivered'
  description           String?       @db.Text
  location              String?       // e.g. 'Chennai Fulfillment Centre'
  carrier               String?
  trackingNumber        String?
  actor                 String?       // 'System' or admin email
  createdAt             DateTime      @default(now())

  order                 Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([createdAt])
  @@map("order_tracking_events")
}

model Payment {
  id                    String        @id @default(uuid())
  orderId               String
  paymentReference      String        @unique // Public reference: e.g. 'AMOGA-PAY-2026-XXXX'
  idempotencyKey        String?       @unique // Unique payment creation idempotency key
  provider              String        // e.g. 'test', 'razorpay', 'cashfree', 'stripe'
  providerOrderId       String?       // Provider's order identifier
  providerPaymentId     String?       // Provider's payment / charge identifier
  amountPaise           Int           // Exact integer paise (e.g. 250000 = Rs 2500.00)
  amount                Decimal       @db.Decimal(10, 2)
  currency              String        @default("INR")
  status                PaymentStatus @default(CREATED)
  metadata              Json?         // Safe provider metadata
  failureCode           String?
  failureMessage        String?
  verifiedAt            DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  order                 Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([providerOrderId])
  @@index([providerPaymentId])
  @@map("payments")
}

model PaymentEvent {
  id                    String        @id @default(uuid())
  provider              String        // e.g. 'test', 'razorpay', 'cashfree', 'stripe'
  providerEventId       String        // Provider's unique event/webhook ID
  orderId               String?
  paymentId             String?
  orderReference        String?
  eventType             String        // e.g. 'payment.succeeded', 'payment.failed'
  status                String        @default("PROCESSED") // 'PROCESSED', 'IGNORED', 'FAILED'
  payload               Json?         // Sanitized event payload
  error                 String?
  receivedAt            DateTime      @default(now())
  processedAt           DateTime?

  @@unique([provider, providerEventId])
  @@index([orderReference])
  @@index([paymentId])
  @@map("payment_events")
}

model OrderItem {
  id            String          @id @default(uuid())
  orderId       String
  productId     String?
  variantId     String?

  // Frozen snapshots at time of order
  collectionId  String
  productName   String
  variantName   String?
  unitPrice     Decimal         @db.Decimal(10, 2)
  quantity      Int
  lineTotal     Decimal         @db.Decimal(10, 2)
  image         String?         @db.Text

  // GST & SKU snapshot
  sku           String?
  hsnCode       String?
  gstRate       Decimal?        @db.Decimal(5, 2)
  isTaxInclusive Boolean        @default(true)
  taxableAmount Decimal?        @db.Decimal(10, 2)
  cgstRate      Decimal?        @db.Decimal(5, 2)
  cgstAmount    Decimal?        @db.Decimal(10, 2)
  sgstRate      Decimal?        @db.Decimal(5, 2)
  sgstAmount    Decimal?        @db.Decimal(10, 2)
  igstRate      Decimal?        @db.Decimal(5, 2)
  igstAmount    Decimal?        @db.Decimal(10, 2)
  cessRate      Decimal?        @db.Decimal(5, 2)
  cessAmount    Decimal?        @db.Decimal(10, 2)
  totalTax      Decimal?        @db.Decimal(10, 2)
  pricingSnapshot Json?

  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// ================= ADMIN SYSTEM MODELS =================

enum InquiryStatus {
  NEW
  IN_PROGRESS
  RESOLVED
}

model AdminUser {
  id                String            @id @default(uuid())
  email             String            @unique
  name              String
  passwordHash      String
  role              AdminRole         @default(CATALOGUE_MANAGER)
  assignedLocationIds Json?           // Array of authorized StockLocation IDs
  isActive          Boolean           @default(true)
  lastLoginAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  sessions          AdminSession[]
  auditLogs         AuditLog[]
  inventoryLogs     InventoryLog[]
  assignedInquiries CustomerInquiry[]
  posSales          PosSale[]
  passwordResetTokens PasswordResetToken[]

  @@map("admin_users")
}

model AdminSession {
  id          String        @id @default(uuid())
  adminId     String
  tokenHash   String        @unique
  expiresAt   DateTime
  createdAt   DateTime      @default(now())

  admin       AdminUser     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([tokenHash])
  @@map("admin_sessions")
}

model AuditLog {
  id            String        @id @default(uuid())
  adminId       String?
  adminEmail    String
  action        String        // e.g. 'PRODUCT_CREATE', 'STOCK_ADJUST', 'ORDER_STATUS_CHANGE'
  entityType    String        // e.g. 'Product', 'Collection', 'Order', 'CustomerInquiry', 'StoreSetting'
  entityId      String?
  status        String        @default("SUCCESS") // 'SUCCESS' | 'FAILURE'
  failureReason String?
  details       Json?
  createdAt     DateTime      @default(now())

  admin         AdminUser?    @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([action])
  @@index([adminEmail])
  @@map("audit_logs")
}

model CustomerInquiry {
  id                 String         @id @default(uuid())
  reference          String         @unique // e.g. 'INQ-XXXXX'
  fullName           String
  email              String
  phone              String?
  subject            String
  message            String         @db.Text
  collectionId       String?        @default("general")
  status             InquiryStatus  @default(NEW)
  internalNotes      String?        @db.Text
  assignedAdminId    String?
  assignedAdminEmail String?
  resolvedAt         DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  assignedAdmin      AdminUser?     @relation(fields: [assignedAdminId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([email])
  @@index([createdAt])
  @@map("customer_inquiries")
}

model InventoryLog {
  id            String          @id @default(uuid())
  productId     String
  variantId     String?
  previousStock Int
  adjustedStock Int
  delta         Int
  reason        String
  adminEmail    String
  adminId       String?
  orderId       String?
  actor         String?
  type          String?
  createdAt     DateTime        @default(now())

  admin         AdminUser?      @relation(fields: [adminId], references: [id], onDelete: SetNull)
  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([createdAt])
  @@map("inventory_logs")
}

model StoreSetting {
  id                       String         @id @default("default")
  storeName                String         @default("Amoga Luxury")
  contactEmail             String         @default("support@amoga.com")
  contactPhone             String         @default("+91 98765 43210")
  shippingStandardRate     Decimal        @default(0.00) @db.Decimal(10, 2)
  freeShippingThreshold    Decimal        @default(2500.00) @db.Decimal(10, 2)
  shippingCarrierName      String?        @default("India Post")
  shippingRulesEnabled     Boolean        @default(true)
  shippingThresholdOperator String        @default("GTE") // "GTE" (>=) or "GT" (>)
  shippingBrackets         Json?          // Array of { minQty: number, maxQty: number, charge: number }
  shippingBeyondMaxRule    String         @default("PER_PIECE") // "PER_PIECE" or "FLAT"
  shippingBeyondMaxBaseCharge Decimal     @default(200.00) @db.Decimal(10, 2)
  shippingBeyondMaxChargePerPiece Decimal @default(50.00) @db.Decimal(10, 2)
  shippingConfiguredBy     String?
  shippingConfiguredAt     DateTime?
  taxPercentage            Decimal        @default(5.00) @db.Decimal(5, 2)
  enableOrderNotifications Boolean        @default(true)
  enableInventoryAlerts    Boolean        @default(true)

  // Seller Registered Tax Details & Compliance
  sellerLegalName          String?        @default("Amoga Luxury Private Limited")
  sellerTradeName          String?        @default("Amoga")
  sellerAddressLine1       String?        @default("108, Heritage Walk, Anna Salai")
  sellerAddressLine2       String?        @default("T. Nagar")
  sellerCity               String?        @default("Chennai")
  sellerState              String?        @default("Tamil Nadu")
  sellerStateCode          String?        @default("33")
  sellerPincode            String?        @default("600017")
  sellerGstin              String?        @default("33AAACA1234A1Z5")
  sellerPan                String?        @default("AAACA1234A")
  invoicePrefix            String?        @default("AMOGA/2026-27/")
  invoiceSequence          Int            @default(1001)
  isTaxEnabled             Boolean        @default(true)
  defaultGstRate           Decimal        @default(5.00) @db.Decimal(5, 2)
  defaultHsnCode           String?        @default("5007")
  isTaxInclusiveDefault    Boolean        @default(true)
  requireTaxVerificationForCheckout Boolean @default(true)
  strictTaxCompliance               Boolean @default(false)

  updatedAt                DateTime       @default(now()) @updatedAt

  @@map("store_settings")
}

model InventoryReservation {
  id             String          @id @default(uuid())
  orderId        String
  orderReference String
  productId      String
  variantId      String?
  quantity       Int
  status         String          @default("ACTIVE") // ACTIVE | COMMITTED | RELEASED | EXPIRED
  expiresAt      DateTime
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([status, expiresAt])
  @@index([orderId])
  @@index([orderReference])
  @@index([productId, variantId])
  @@map("inventory_reservations")
}

model RestockSubscription {
  id             String          @id @default(uuid())
  productId      String
  variantId      String?
  customerId     String?
  channel        String          @default("EMAIL") // 'EMAIL' | 'SMS'
  destination    String
  consentGiven   Boolean         @default(true)
  consentAt      DateTime        @default(now())
  status         String          @default("ACTIVE") // ACTIVE | QUEUED | NOTIFIED | CANCELLED | FAILED
  notifiedAt     DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  customer       Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([productId, variantId, status])
  @@index([destination])
  @@index([customerId])
  @@map("restock_subscriptions")
}

model InventoryAlert {
  id            String          @id @default(uuid())
  productId     String
  variantId     String?
  alertType     String          // 'LOW_STOCK' | 'OUT_OF_STOCK'
  stockQuantity Int
  threshold     Int
  status        String          @default("ACTIVE") // ACTIVE | RESOLVED
  createdAt     DateTime        @default(now())
  resolvedAt    DateTime?

  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId, variantId, status])
  @@index([createdAt])
  @@map("inventory_alerts")
}

model RestockNotificationJob {
  id                String          @id @default(uuid())
  subscriptionId    String?
  productId         String
  variantId         String?
  recipientType     String          // 'CUSTOMER' | 'ADMIN'
  channel           String          @default("EMAIL")
  destination       String
  subject           String?
  message           String          @db.Text
  status            String          @default("PENDING") // PENDING | SENT | FAILED | NO_PROVIDER_CONFIGURED
  provider          String?
  providerMessageId String?
  attempts          Int             @default(0)
  lastAttemptAt     DateTime?
  error             String?
  metadata          Json?
  createdAt         DateTime        @default(now())
  sentAt            DateTime?

  product           Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant           ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([productId, variantId])
  @@map("restock_notification_jobs")
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id              String        @id @default(uuid())
  productId       String
  customerId      String?
  authorName      String
  rating          Int           // 1 to 5
  title           String?
  content         String        @db.Text
  status          ReviewStatus  @default(PENDING)
  isVerifiedBuyer Boolean       @default(false)
  moderationNotes String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer        Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([productId, status])
  @@index([customerId])
  @@map("reviews")
}

model SkuSequence {
  prefix     String   @id
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@map("sku_sequences")
}

model HsnReference {
  id             String   @id @default(uuid())
  hsnCode        String
  description    String   @db.Text
  level          String   // 'CHAPTER' | 'HEADING' | 'SUBHEADING' | 'TARIFF_ITEM' | 'OTHER'
  codeLength     Int
  sourceFileName String   @default("HSN_SAC.pdf")
  importDate     DateTime @default(now())
  sourcePage     Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([hsnCode])
  @@index([level])
  @@map("hsn_references")
}

model GstRateMaster {
  id             String    @id @default(uuid())
  hsnCode        String
  description    String    @db.Text
  gstRate        Decimal   @db.Decimal(5, 2)
  taxTreatment   String    @default("TAXABLE") // 'TAXABLE' | 'NIL_RATED' | 'EXEMPT' | 'NON_GST'
  cessRate       Decimal   @default(0.00) @db.Decimal(5, 2)
  effectiveFrom  DateTime?
  effectiveTo    DateTime?
  officialSource String?
  status         String    @default("APPROVED") // 'APPROVED' | 'PENDING_REVIEW' | 'INACTIVE'
  verifiedBy     String?
  verifiedAt     DateTime?
  notes          String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([hsnCode])
  @@index([status])
  @@map("gst_rate_master")
}

// ================= STALL BILLING & POS MODELS =================

model StallEvent {
  id                 String     @id @default(uuid())
  code               String     @unique // e.g. "EVENT-2026-001"
  name               String
  venue              String
  address            String?
  city               String?
  state              String?
  stateCode          String?    @default("33") // Place of supply state code
  startDate          DateTime
  endDate            DateTime
  status             String     @default("ACTIVE") // ACTIVE | UPCOMING | COMPLETED | ARCHIVED
  openingCashBalance Decimal    @default(0.00) @db.Decimal(10, 2)
  assignedStaffIds   Json?      // Array of admin user IDs or emails
  notes              String?    @db.Text
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  posSales           PosSale[]
  stockLocation      StockLocation?

  @@index([status])
  @@index([startDate, endDate])
  @@map("stall_events")
}

model PosSale {
  id                         String              @id @default(uuid())
  billNumber                 String              @unique // e.g. "AMOGA-POS-2026-0001"
  idempotencyKey             String?             @unique
  publicReceiptToken         String              @unique // Secure unguessable token
  stallEventId               String?
  staffId                    String?
  staffEmail                 String
  staffName                  String?
  customerName               String?
  customerPhone              String?
  customerEmail              String?
  customerGstin              String?
  status                     String              @default("COMPLETED") // COMPLETED | CANCELLED | REFUNDED | PARTIALLY_PAID
  paymentStatus              String              @default("PAID") // PAID | PARTIALLY_PAID | PENDING | REFUNDED | FAILED
  paymentMethod              String              @default("CASH") // CASH | UPI | CARD | SPLIT | OTHER
  paymentReference           String?
  amountPaid                 Decimal             @db.Decimal(10, 2)
  changeDue                  Decimal             @default(0.00) @db.Decimal(10, 2)
  subtotal                   Decimal             @db.Decimal(10, 2) // Gross inclusive subtotal
  discountAmount             Decimal             @default(0.00) @db.Decimal(10, 2)
  discountReason             String?
  discountApprovedBy         String?
  taxableAmount              Decimal             @db.Decimal(10, 2)
  cgstAmount                 Decimal             @default(0.00) @db.Decimal(10, 2)
  sgstAmount                 Decimal             @default(0.00) @db.Decimal(10, 2)
  igstAmount                 Decimal             @default(0.00) @db.Decimal(10, 2)
  totalTaxAmount             Decimal             @db.Decimal(10, 2)
  totalAmount                Decimal             @db.Decimal(10, 2)
  totalItemsCount            Int                 @default(0)
  taxSnapshot                Json?
  pricingSnapshot            Json?
  whatsappDeliveryStatus     String              @default("NOT_REQUESTED") // NOT_REQUESTED | PENDING | SENT | FAILED | MANUAL_OPENED
  whatsappMessageId          String?
  whatsappSentAt             DateTime?
  whatsappError              String?
  whatsappOptOutTextIncluded Boolean             @default(true)
  notes                      String?             @db.Text
  cancelledAt                DateTime?
  cancelledReason            String?             @db.Text
  refundedAmount             Decimal?            @default(0.00) @db.Decimal(10, 2)
  refundedAt                 DateTime?
  refundReason               String?             @db.Text
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt

  stockLocationId            String?

  stallEvent                 StallEvent?         @relation(fields: [stallEventId], references: [id], onDelete: SetNull)
  stockLocation              StockLocation?      @relation(fields: [stockLocationId], references: [id], onDelete: SetNull)
  staff                      AdminUser?          @relation(fields: [staffId], references: [id], onDelete: SetNull)
  items                      PosSaleItem[]
  payments                   PosPaymentRecord[]

  @@index([billNumber])
  @@index([stallEventId])
  @@index([stockLocationId])
  @@index([staffEmail])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([customerPhone])
  @@map("pos_sales")
}

model PosSaleItem {
  id              String          @id @default(uuid())
  posSaleId       String
  productId       String?
  variantId       String?
  collectionId    String
  productName     String
  variantName     String?
  sku             String?
  hsnCode         String?
  gstRate         Decimal         @db.Decimal(5, 2)
  isTaxInclusive  Boolean         @default(true)
  unitPrice       Decimal         @db.Decimal(10, 2)
  quantity        Int
  lineDiscount    Decimal         @default(0.00) @db.Decimal(10, 2)
  lineTotal       Decimal         @db.Decimal(10, 2)
  taxableAmount   Decimal         @db.Decimal(10, 2)
  cgstAmount      Decimal         @default(0.00) @db.Decimal(10, 2)
  sgstAmount      Decimal         @default(0.00) @db.Decimal(10, 2)
  igstAmount      Decimal         @default(0.00) @db.Decimal(10, 2)
  totalTax        Decimal         @db.Decimal(10, 2)
  pricingSnapshot Json?
  createdAt       DateTime        @default(now())

  posSale         PosSale         @relation(fields: [posSaleId], references: [id], onDelete: Cascade)
  product         Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([posSaleId])
  @@index([productId])
  @@map("pos_sale_items")
}

model PosPaymentRecord {
  id            String   @id @default(uuid())
  posSaleId     String
  paymentMethod String   // CASH | UPI | CARD | OTHER
  amount        Decimal  @db.Decimal(10, 2)
  amountPaise   Int
  reference     String?
  status        String   @default("SUCCEEDED")
  createdAt     DateTime @default(now())

  posSale       PosSale  @relation(fields: [posSaleId], references: [id], onDelete: Cascade)

  @@index([posSaleId])
  @@map("pos_payment_records")
}

model PosSequence {
  prefix     String   @id
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@map("pos_sequences")
}

model PosSetting {
  id                                String   @id @default("default")
  defaultStallId                    String?
  enableBarcodeScanner              Boolean  @default(true)
  enableThermalPrint                Boolean  @default(true)
  receiptPrinterWidth               String   @default("80mm") // 80mm | 58mm | standard
  enableWhatsAppReceipt             Boolean  @default(true)
  whatsAppChannel                   String   @default("MANUAL") // MANUAL | CLOUD_API
  whatsAppPhoneNumberId             String?
  whatsAppTemplateName              String?  @default("amoga_pos_bill")
  maxDiscountPercentWithoutApproval Decimal  @default(15.00) @db.Decimal(5, 2)
  requireCustomerPhone              Boolean  @default(false)
  posPrefix                         String   @default("AMOGA-POS-2026/")
  updatedAt                         DateTime @default(now()) @updatedAt

  @@map("pos_settings")
}

// ================= STOCK LOCATIONS & INDEPENDENT STALL INVENTORY =================

model StockLocation {
  id                 String              @id @default(uuid())
  code               String              @unique // e.g. "MAIN-WAREHOUSE", "ONLINE-STORE", "STALL-EXPO-01"
  name               String              // e.g. "Amoga Central Warehouse", "Online Storefront", "Chennai Trade Centre Stall"
  type               String              @default("STALL") // 'WAREHOUSE' | 'ONLINE' | 'STALL' | 'EVENT'
  stallEventId       String?             @unique
  address            String?
  city               String?
  state              String?
  isActive           Boolean             @default(true)
  isDefault          Boolean             @default(false)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  stallEvent         StallEvent?         @relation(fields: [stallEventId], references: [id], onDelete: SetNull)
  inventories        LocationInventory[]
  transfersFrom      StockTransfer[]     @relation("SourceLocation")
  transfersTo        StockTransfer[]     @relation("DestinationLocation")
  movementLogs       LocationMovementLog[]
  posSales           PosSale[]

  @@index([type])
  @@index([isActive])
  @@map("stock_locations")
}

model LocationInventory {
  id                 String          @id @default(uuid())
  locationId         String
  productId          String
  variantId          String?
  onHandQuantity     Int             @default(0)
  reservedQuantity   Int             @default(0)
  reorderThreshold   Int             @default(5)
  lastMovementAt     DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  location           StockLocation   @relation(fields: [locationId], references: [id], onDelete: Cascade)
  product            Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant            ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@unique([locationId, productId, variantId])
  @@index([locationId])
  @@index([productId])
  @@index([variantId])
  @@map("location_inventories")
}

model StockTransfer {
  id                    String              @id @default(uuid())
  transferNumber        String              @unique // e.g. "TRF-2026-0001"
  sourceLocationId      String
  destinationLocationId String
  status                String              @default("COMPLETED") // 'PENDING' | 'IN_TRANSIT' | 'COMPLETED' | 'CANCELLED'
  initiatedById         String?
  initiatedByEmail      String
  receivedById          String?
  receivedByEmail       String?
  reason                String?
  notes                 String?             @db.Text
  transferredAt         DateTime?           @default(now())
  receivedAt            DateTime?           @default(now())
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  sourceLocation        StockLocation       @relation("SourceLocation", fields: [sourceLocationId], references: [id], onDelete: Restrict)
  destinationLocation   StockLocation       @relation("DestinationLocation", fields: [destinationLocationId], references: [id], onDelete: Restrict)
  items                 StockTransferItem[]

  @@index([sourceLocationId])
  @@index([destinationLocationId])
  @@index([status])
  @@index([createdAt])
  @@map("stock_transfers")
}

model StockTransferItem {
  id               String          @id @default(uuid())
  transferId       String
  productId        String
  variantId        String?
  quantity         Int
  receivedQuantity Int?
  notes            String?

  transfer         StockTransfer   @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant          ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([transferId])
  @@index([productId])
  @@map("stock_transfer_items")
}

model LocationMovementLog {
  id                String          @id @default(uuid())
  locationId        String
  productId         String
  variantId         String?
  previousQuantity  Int
  newQuantity       Int
  delta             Int
  movementType      String          // 'OPENING_BALANCE' | 'TRANSFER_IN' | 'TRANSFER_OUT' | 'STALL_POS' | 'ADJUSTMENT' | 'RETURN'
  reference         String?         // Bill number, Transfer number, or Adjustment ref
  actorEmail        String
  actorId           String?
  reason            String?
  createdAt         DateTime        @default(now())

  location          StockLocation   @relation(fields: [locationId], references: [id], onDelete: Cascade)
  product           Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant           ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([locationId])
  @@index([productId])
  @@index([reference])
  @@index([createdAt])
  @@map("location_movement_logs")
}

// ================= PASSWORD RESET TOKENS =================

model PasswordResetToken {
  id            String      @id @default(uuid())
  tokenHash     String      @unique
  accountType   String      // 'CUSTOMER' | 'STAFF'
  email         String
  customerId    String?
  adminUserId   String?
  expiresAt     DateTime
  consumedAt    DateTime?
  createdAt     DateTime    @default(now())
  createdBy     String?

  customer      Customer?   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  adminUser     AdminUser?  @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([email, accountType])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}


