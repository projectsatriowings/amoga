// AMOGA E-COMMERCE — PRISMA SCHEMA
// Supports Multi-Collection Storefronts (Food, Sarees, Jewellery, Tea), Persistent Orders & Admin Panel

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Collection {
  id               String    @id // 'food' | 'sarees' | 'jewellery' | 'tea'
  name             String
  slug             String    @unique
  tagline          String?
  heroHeading      String?
  heroSubheading   String?
  description      String?
  shortDescription String?
  heroImage        String?   @db.Text
  cardImage        String?   @db.Text
  theme            String?
  accentColor      String?
  themeConfig      Json?     // Full palette customization (bg, surface, text, accent, buttonBg, border, etc.)
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  products         Product[]

  @@map("collections")
}

model Product {
  id               String           @id @default(uuid())
  sourceId         String           @unique // e.g. 'f-turmeric-01', 's-kanchipuram-01', 'j-aurora-01'
  collectionId     String
  slug             String
  name             String
  tagline          String?
  description      String           @db.Text
  category         String
  categoryName     String?
  price            Decimal?         @db.Decimal(10, 2) // Nullable for unconfirmed bespoke items
  originalPrice    Decimal?         @db.Decimal(10, 2)
  discount         String?
  currency         String           @default("INR")
  image            String           @db.Text
  gallery          Json?            // Array of image paths/URLs
  packSize         String?
  inStock          Boolean          @default(true)
  stockQuantity    Int              @default(50)
  reservedQuantity Int              @default(0)
  lowStockThreshold Int             @default(5)
  isFeatured       Boolean          @default(false)
  badge            String?
  rating           Float?
  reviewCount      Int?
  specs            Json?            // Product attributes / technical specifications
  sourceCatalogue  String?
  verified         Boolean          @default(false)
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  collection            Collection             @relation(fields: [collectionId], references: [id], onDelete: Restrict)
  variants              ProductVariant[]
  orderItems            OrderItem[]
  inventoryLogs         InventoryLog[]
  inventoryReservations InventoryReservation[]
  restockSubscriptions  RestockSubscription[]
  inventoryAlerts       InventoryAlert[]
  notificationJobs      RestockNotificationJob[]
  reviews               Review[]

  @@unique([collectionId, slug])
  @@index([collectionId])
  @@index([category])
  @@index([inStock])
  @@map("products")
}

model ProductVariant {
  id            String         @id @default(uuid())
  sourceId      String?        // e.g. 'v-wine', 'ring-16'
  productId     String
  name          String         // e.g. 'Royal Wine', 'US 7'
  sku           String?
  price         Decimal?       @db.Decimal(10, 2)
  inStock          Boolean          @default(true)
  stockQuantity    Int              @default(25)
  reservedQuantity Int              @default(0)
  lowStockThreshold Int             @default(5)
  attributes       Json?          // e.g. { hex: '#451523' } or { size: 'US 6' }
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  product               Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems            OrderItem[]
  inventoryLogs         InventoryLog[]
  inventoryReservations InventoryReservation[]
  restockSubscriptions  RestockSubscription[]
  inventoryAlerts       InventoryAlert[]
  notificationJobs      RestockNotificationJob[]

  @@index([productId])
  @@map("product_variants")
}

enum OrderStatus {
  PENDING_PAYMENT
  PENDING_CONFIRMATION
  CONFIRMED
  PROCESSING
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  CREATED
  PENDING
  AUTHORIZED
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum AdminRole {
  SUPER_ADMIN
  CATALOGUE_MANAGER
  ORDER_MANAGER
  CONTENT_MANAGER
}

model Order {
  id                    String        @id @default(uuid())
  orderReference        String        @unique // Public non-guessable reference: e.g. 'AMOGA-ORD-2026-XXXXX'
  idempotencyKey        String?       @unique // Duplicate submission protection
  guestAccessTokenHash  String?       // Secure hash for guest retrieval
  status                OrderStatus   @default(PENDING_PAYMENT)
  paymentStatus         PaymentStatus @default(PENDING)
  currency              String        @default("INR")
  
  // Financial totals snapshot
  subtotal              Decimal       @db.Decimal(10, 2)
  shippingAmount        Decimal       @default(0.00) @db.Decimal(10, 2)
  taxAmount             Decimal       @default(0.00) @db.Decimal(10, 2)
  discountAmount        Decimal       @default(0.00) @db.Decimal(10, 2)
  totalAmount           Decimal       @db.Decimal(10, 2)

  // Customer Contact & Shipping Destination Snapshot
  customerName          String
  customerEmail         String
  customerPhone         String
  addressLine1          String
  addressLine2          String?
  city                  String
  state                 String
  pincode               String
  deliveryInstructions  String?       @db.Text

  // Carrier & Fulfilment tracking
  carrier               String?
  trackingNumber        String?
  trackingUrl           String?

  // Customer relation
  customerId            String?
  customer              Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // Mode and metadata
  isDemo                Boolean       @default(false)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  items                 OrderItem[]
  payments              Payment[]
  trackingEvents        OrderTrackingEvent[]

  @@index([orderReference])
  @@index([customerEmail])
  @@index([customerId])
  @@index([createdAt])
  @@map("orders")
}

model Customer {
  id                    String            @id @default(uuid())
  email                 String            @unique
  name                  String
  phone                 String?
  passwordHash          String
  isActive              Boolean           @default(true)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  sessions              CustomerSession[]
  addresses             CustomerAddress[]
  orders                Order[]
  restockSubscriptions  RestockSubscription[]
  reviews               Review[]

  @@map("customers")
}

model CustomerSession {
  id                    String        @id @default(uuid())
  customerId            String
  tokenHash             String        @unique
  expiresAt             DateTime
  createdAt             DateTime      @default(now())

  customer              Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([tokenHash])
  @@map("customer_sessions")
}

model CustomerAddress {
  id                    String        @id @default(uuid())
  customerId            String
  label                 String?       // e.g. 'Home', 'Work', 'Estate'
  fullName              String
  phone                 String
  addressLine1          String
  addressLine2          String?
  city                  String
  state                 String
  pincode               String
  isDefault             Boolean       @default(false)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  customer              Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_addresses")
}

model OrderTrackingEvent {
  id                    String        @id @default(uuid())
  orderId               String
  status                OrderStatus
  title                 String        // e.g. 'Order Confirmed', 'Processing at Atelier', 'Shipped', 'Out for Delivery', 'Delivered'
  description           String?       @db.Text
  location              String?       // e.g. 'Chennai Fulfillment Centre'
  carrier               String?
  trackingNumber        String?
  actor                 String?       // 'System' or admin email
  createdAt             DateTime      @default(now())

  order                 Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([createdAt])
  @@map("order_tracking_events")
}

model Payment {
  id                    String        @id @default(uuid())
  orderId               String
  paymentReference      String        @unique // Public reference: e.g. 'AMOGA-PAY-2026-XXXX'
  idempotencyKey        String?       @unique // Unique payment creation idempotency key
  provider              String        // e.g. 'test', 'razorpay', 'cashfree', 'stripe'
  providerOrderId       String?       // Provider's order identifier
  providerPaymentId     String?       // Provider's payment / charge identifier
  amountPaise           Int           // Exact integer paise (e.g. 250000 = Rs 2500.00)
  amount                Decimal       @db.Decimal(10, 2)
  currency              String        @default("INR")
  status                PaymentStatus @default(CREATED)
  metadata              Json?         // Safe provider metadata
  failureCode           String?
  failureMessage        String?
  verifiedAt            DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  order                 Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([providerOrderId])
  @@index([providerPaymentId])
  @@map("payments")
}

model PaymentEvent {
  id                    String        @id @default(uuid())
  provider              String        // e.g. 'test', 'razorpay', 'cashfree', 'stripe'
  providerEventId       String        // Provider's unique event/webhook ID
  orderId               String?
  paymentId             String?
  orderReference        String?
  eventType             String        // e.g. 'payment.succeeded', 'payment.failed'
  status                String        @default("PROCESSED") // 'PROCESSED', 'IGNORED', 'FAILED'
  payload               Json?         // Sanitized event payload
  error                 String?
  receivedAt            DateTime      @default(now())
  processedAt           DateTime?

  @@unique([provider, providerEventId])
  @@index([orderReference])
  @@index([paymentId])
  @@map("payment_events")
}

model OrderItem {
  id            String          @id @default(uuid())
  orderId       String
  productId     String?
  variantId     String?

  // Frozen snapshots at time of order
  collectionId  String
  productName   String
  variantName   String?
  unitPrice     Decimal         @db.Decimal(10, 2)
  quantity      Int
  lineTotal     Decimal         @db.Decimal(10, 2)
  image         String?         @db.Text

  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// ================= ADMIN SYSTEM MODELS =================

enum InquiryStatus {
  NEW
  IN_PROGRESS
  RESOLVED
}

model AdminUser {
  id                String            @id @default(uuid())
  email             String            @unique
  name              String
  passwordHash      String
  role              AdminRole         @default(CATALOGUE_MANAGER)
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  sessions          AdminSession[]
  auditLogs         AuditLog[]
  inventoryLogs     InventoryLog[]
  assignedInquiries CustomerInquiry[]

  @@map("admin_users")
}

model AdminSession {
  id          String        @id @default(uuid())
  adminId     String
  tokenHash   String        @unique
  expiresAt   DateTime
  createdAt   DateTime      @default(now())

  admin       AdminUser     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([tokenHash])
  @@map("admin_sessions")
}

model AuditLog {
  id            String        @id @default(uuid())
  adminId       String?
  adminEmail    String
  action        String        // e.g. 'PRODUCT_CREATE', 'STOCK_ADJUST', 'ORDER_STATUS_CHANGE'
  entityType    String        // e.g. 'Product', 'Collection', 'Order', 'CustomerInquiry', 'StoreSetting'
  entityId      String?
  status        String        @default("SUCCESS") // 'SUCCESS' | 'FAILURE'
  failureReason String?
  details       Json?
  createdAt     DateTime      @default(now())

  admin         AdminUser?    @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([action])
  @@index([adminEmail])
  @@map("audit_logs")
}

model CustomerInquiry {
  id                 String         @id @default(uuid())
  reference          String         @unique // e.g. 'INQ-XXXXX'
  fullName           String
  email              String
  phone              String?
  subject            String
  message            String         @db.Text
  collectionId       String?        @default("general")
  status             InquiryStatus  @default(NEW)
  internalNotes      String?        @db.Text
  assignedAdminId    String?
  assignedAdminEmail String?
  resolvedAt         DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  assignedAdmin      AdminUser?     @relation(fields: [assignedAdminId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([email])
  @@index([createdAt])
  @@map("customer_inquiries")
}

model InventoryLog {
  id            String          @id @default(uuid())
  productId     String
  variantId     String?
  previousStock Int
  adjustedStock Int
  delta         Int
  reason        String
  adminEmail    String
  adminId       String?
  orderId       String?
  actor         String?
  type          String?
  createdAt     DateTime        @default(now())

  admin         AdminUser?      @relation(fields: [adminId], references: [id], onDelete: SetNull)
  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([createdAt])
  @@map("inventory_logs")
}

model Coupon {
  id                    String        @id @default(uuid())
  code                  String        @unique
  name                  String?
  description           String?
  discountType          String        // 'PERCENTAGE' | 'FIXED'
  discountValue         Decimal       @db.Decimal(10, 2)
  minOrderAmount        Decimal?      @db.Decimal(10, 2)
  maxDiscountAmount     Decimal?      @db.Decimal(10, 2)
  usageLimit            Int?
  usedCount             Int           @default(0)
  isActive              Boolean       @default(true)
  startsAt              DateTime?
  expiresAt             DateTime?
  applicableCollections Json?         // Array of collection IDs, e.g. ["food", "tea"], or null for storewide
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([code])
  @@map("coupons")
}

model StoreSetting {
  id                       String         @id @default("default")
  storeName                String         @default("Amoga Luxury")
  contactEmail             String         @default("support@amoga.com")
  contactPhone             String         @default("+91 98765 43210")
  shippingStandardRate     Decimal        @default(0.00) @db.Decimal(10, 2)
  freeShippingThreshold    Decimal        @default(2000.00) @db.Decimal(10, 2)
  taxPercentage            Decimal        @default(5.00) @db.Decimal(5, 2)
  enableOrderNotifications Boolean        @default(true)
  enableInventoryAlerts    Boolean        @default(true)
  updatedAt                DateTime       @default(now()) @updatedAt

  @@map("store_settings")
}

model InventoryReservation {
  id             String          @id @default(uuid())
  orderId        String
  orderReference String
  productId      String
  variantId      String?
  quantity       Int
  status         String          @default("ACTIVE") // ACTIVE | COMMITTED | RELEASED | EXPIRED
  expiresAt      DateTime
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([status, expiresAt])
  @@index([orderId])
  @@index([orderReference])
  @@index([productId, variantId])
  @@map("inventory_reservations")
}

model RestockSubscription {
  id             String          @id @default(uuid())
  productId      String
  variantId      String?
  customerId     String?
  channel        String          @default("EMAIL") // 'EMAIL' | 'SMS'
  destination    String
  consentGiven   Boolean         @default(true)
  consentAt      DateTime        @default(now())
  status         String          @default("ACTIVE") // ACTIVE | QUEUED | NOTIFIED | CANCELLED | FAILED
  notifiedAt     DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  customer       Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([productId, variantId, status])
  @@index([destination])
  @@index([customerId])
  @@map("restock_subscriptions")
}

model InventoryAlert {
  id            String          @id @default(uuid())
  productId     String
  variantId     String?
  alertType     String          // 'LOW_STOCK' | 'OUT_OF_STOCK'
  stockQuantity Int
  threshold     Int
  status        String          @default("ACTIVE") // ACTIVE | RESOLVED
  createdAt     DateTime        @default(now())
  resolvedAt    DateTime?

  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId, variantId, status])
  @@index([createdAt])
  @@map("inventory_alerts")
}

model RestockNotificationJob {
  id                String          @id @default(uuid())
  subscriptionId    String?
  productId         String
  variantId         String?
  recipientType     String          // 'CUSTOMER' | 'ADMIN'
  channel           String          @default("EMAIL")
  destination       String
  subject           String?
  message           String          @db.Text
  status            String          @default("PENDING") // PENDING | SENT | FAILED | NO_PROVIDER_CONFIGURED
  provider          String?
  providerMessageId String?
  attempts          Int             @default(0)
  lastAttemptAt     DateTime?
  error             String?
  metadata          Json?
  createdAt         DateTime        @default(now())
  sentAt            DateTime?

  product           Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant           ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([productId, variantId])
  @@map("restock_notification_jobs")
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id              String        @id @default(uuid())
  productId       String
  customerId      String?
  authorName      String
  rating          Int           // 1 to 5
  title           String?
  content         String        @db.Text
  status          ReviewStatus  @default(PENDING)
  isVerifiedBuyer Boolean       @default(false)
  moderationNotes String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  product         Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  customer        Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([productId, status])
  @@index([customerId])
  @@map("reviews")
}

